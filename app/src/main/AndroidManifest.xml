<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <!-- 1번 감지: 속도(안드로이드 차량 API), 핸들·기어(Pleos) -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <!-- 내비 안내가 끝났을 때 "곁으로 돌아가기" 알림 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 비상 모드: 112/119/긴급견인/비상연락처 전화, 연료(주행 가능 거리) -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.car.permission.CAR_ENERGY" />
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />

    <!-- 내비 길안내 중 곁이 멈추지(freeze) 않게 지켜보는 서비스 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- 차량 권한 (조회 CAR_* / 제어 CONTROL_CAR_*) -->
    <uses-permission android:name="pleos.car.permission.CAR_DOORS" />
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_DOORS" />
    <uses-permission android:name="pleos.car.permission.CAR_CLIMATE" />
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_CLIMATE" />
    <uses-permission android:name="pleos.car.permission.CAR_WINDOWS" />
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_WINDOWS" />
    <!-- 5. 파워냅: 시트·조명 조회·제어, P단 감지 -->
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_SEATS" />
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_LIGHTS" />
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
    <uses-permission android:name="pleos.car.permission.NAVI_CUSTOM_MAP" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Pleos TTS (음성 안내·퀴즈) -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 음성 퀴즈용 마이크 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- 안드로이드 11 이상에서 음성 인식·TTS 서비스를 찾기 위해 필요 -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Motor_rookie"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Motor_rookie">
            <!-- D단(주행 중)에도 화면이 가려지지 않게 -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- 내비 길안내가 끝날 때까지 곁이 멈추지 않게 (안내 종료 → 곁으로 돌아오기) -->
        <service
            android:name=".intervention.GuideWatchService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Watches navigation guidance started by the app and returns to the app when guidance ends" />
        </service>
    </application>

</manifest>
